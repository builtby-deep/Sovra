<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sovra_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="System TTS defaults" android:textColor="@color/sovra_text" android:textSize="24sp" android:textStyle="bold" />
        <Spinner android:id="@+id/tts_language" android:layout_width="match_parent" android:layout_height="52dp" />
        <Spinner android:id="@+id/tts_model_type" android:layout_width="match_parent" android:layout_height="52dp" />
        <Spinner android:id="@+id/tts_voice" android:layout_width="match_parent" android:layout_height="52dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/save_tts_default" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="6dp" android:text="Save default voice" />
        <com.google.android.material.button.MaterialButton android:id="@+id/clear_tts_default" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp" android:text="Clear language default" />
    </LinearLayout>
</ScrollView>
