<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sovra_background">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Settings" android:textColor="@color/sovra_text" android:textSize="26sp" android:textStyle="bold" />
        <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/smart_punct" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Smart Punctuation" />
        <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/emotion_tags" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Emotion Tags" />
        <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/multi_speaker_tags" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Multi-Speaker Tags" />
        <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/mms_models_enabled" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="MMS Catalog" />
        <TextView android:id="@+id/pitch_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Pitch: 1.00" android:textColor="@color/sovra_text" />
        <SeekBar android:id="@+id/voice_pitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" />
        <TextView android:id="@+id/speed_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Speed: 1.00" android:textColor="@color/sovra_text" />
        <SeekBar android:id="@+id/voice_speed" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" />
        <TextView android:id="@+id/silence_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Silence: 0.50" android:textColor="@color/sovra_text" />
        <SeekBar android:id="@+id/silence_scale" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" />
        <Spinner android:id="@+id/voice_style" android:layout_width="match_parent" android:layout_height="48dp" />
        <TextView android:id="@+id/storage_usage" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:textColor="@color/sovra_muted" />
        <com.google.android.material.button.MaterialButton android:id="@+id/android_tts_settings" android:layout_width="match_parent" android:layout_height="48dp" android:text="Android System TTS Settings" />
        <com.google.android.material.button.MaterialButton android:id="@+id/repository_link" android:layout_width="match_parent" android:layout_height="48dp" android:text="Sovra on GitHub" />
        <com.google.android.material.button.MaterialButton android:id="@+id/factory_reset" android:layout_width="match_parent" android:layout_height="48dp" android:text="Factory reset" />
    </LinearLayout>
</ScrollView>
