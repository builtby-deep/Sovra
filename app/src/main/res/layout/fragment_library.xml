<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/sovra_background">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Audio library" android:textColor="@color/sovra_text" android:textSize="26sp" android:textStyle="bold" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton android:id="@+id/library_all" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="All" />
        <com.google.android.material.button.MaterialButton android:id="@+id/library_favorites" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="Favorites" />
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:id="@+id/library_entries" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
    </ScrollView>
    <LinearLayout android:id="@+id/mini_player" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_card" android:gravity="center_vertical" android:orientation="vertical" android:padding="12dp">
        <TextView android:id="@+id/now_playing" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nothing playing" android:textColor="@color/sovra_text" android:textStyle="bold" />
        <SeekBar android:id="@+id/library_seek" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/library_previous" android:layout_width="wrap_content" android:layout_height="42dp" android:text="Previous" />
            <com.google.android.material.button.MaterialButton android:id="@+id/library_play_pause" android:layout_width="wrap_content" android:layout_height="42dp" android:text="Play" />
            <com.google.android.material.button.MaterialButton android:id="@+id/library_next" android:layout_width="wrap_content" android:layout_height="42dp" android:text="Next" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
