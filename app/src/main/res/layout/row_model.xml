<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardBackgroundColor="@color/sovra_surface"
    app:cardCornerRadius="14dp"
    app:strokeColor="@color/sovra_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:background="@drawable/bg_badge_blue"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                android:text="ONNX"
                android:textColor="@color/sovra_accent"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_marginStart="5dp"
                android:background="@drawable/bg_badge_green"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                android:text="Token ✓"
                android:textColor="@color/sovra_green"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/model_active"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_marginStart="5dp"
                android:background="@drawable/bg_badge_green"
                android:gravity="center"
                android:paddingHorizontal="7dp"
                android:text="✓"
                android:textColor="@color/sovra_green"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/model_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:maxLines="2"
            android:minLines="2"
            android:textColor="@color/sovra_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/model_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:maxLines="2"
            android:minLines="2"
            android:textColor="@color/sovra_muted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/model_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/sovra_accent"
            android:textSize="10sp" />

        <ProgressBar
            android:id="@+id/model_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="5dp"
            android:indeterminate="false"
            android:progressTint="@color/sovra_accent"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/model_primary_action"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="Download"
                android:textSize="11sp"
                app:backgroundTint="@color/sovra_blue" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/model_delete_action"
                style="@style/SovraIconButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:contentDescription="Remove downloaded model"
                android:visibility="gone"
                app:backgroundTint="@color/sovra_border"
                app:icon="@drawable/ic_delete"
                app:iconSize="18dp"
                app:iconTint="@color/sovra_text" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
